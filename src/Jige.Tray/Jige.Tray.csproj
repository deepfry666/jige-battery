<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Jige</AssemblyName>
    <RootNamespace>Jige.Tray</RootNamespace>
    <ApplicationIcon>../../assets/jige.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
    <IsAotCompatible>true</IsAotCompatible>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishAot Condition="'$(RuntimeIdentifier)' == 'win-x64'">true</PublishAot>
    <OptimizationPreference Condition="'$(PublishAot)' == 'true'">Size</OptimizationPreference>
    <DebuggerSupport Condition="'$(PublishAot)' == 'true'">false</DebuggerSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.371" PrivateAssets="all" />
    <ProjectReference Include="../Jige.Core/Jige.Core.csproj" />
    <InternalsVisibleTo Include="Jige.Tray.Tests" />
    <EmbeddedResource Include="../../assets/jige-panel.bgra" LogicalName="Jige.PanelIcon" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
  </ItemGroup>
</Project>
